&share
 wrf_core = 'ARW',
 max_dom = @MAX_DOM@,
 start_date = '@START@','@START@','@START@','@START@',
 end_date   = '@END@','@END@','@END@','@END@',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,   2,   3,
 parent_grid_ratio =   1,   3,   3,   3,
 i_parent_start    =   1,  36,  46,  64,
 j_parent_start    =   1,  31,  36,  49,
 e_we              = 121, 151, 181, 121,
 e_sn              = 101, 121, 151, 121,
 geog_data_res     = 'default','default','default','default',
 dx = 9000,
 dy = 9000,
 map_proj  = 'lambert',
 ref_lat   =  41.10,
 ref_lon   =  28.90,
 truelat1  =  38.0,
 truelat2  =  44.0,
 stand_lon =  28.90,
 geog_data_path = '@GEOG@'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
